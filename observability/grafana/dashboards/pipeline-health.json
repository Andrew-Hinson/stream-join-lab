    {
      "id": 6,
      "title": "Alerts",
      "type": "alertlist",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "options": {
        "alertName": "",
        "dashboardAlerts": false,
        "groupMode": "default",
        "maxItems": 10,
        "sortOrder": 1,
        "stateFilter": {
          "error": true,
          "firing": true,
          "noData": false,
          "normal": false,
          "pending": true
        },
        "viewMode": "list"
      }
    },
    {
      "id": 7,
      "title": "Join buffer and checkpoint",
      "type": "text",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 4 },
      "mode": "markdown",
      "content": "MatchJoin buffers a match for **3** seconds, then emits a complete roster or drops an incomplete one. The job checkpoints every **10** seconds.",
      "options": {
        "mode": "markdown",
        "content": "MatchJoin buffers a match for **3** seconds, then emits a complete roster or drops an incomplete one. The job checkpoints every **10** seconds."
      }
    },
    {
      "id": 8,
      "title": "Debezium events",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": false }, "unit": "ops" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "expr": "sum(rate({__name__=~\"debezium_.*totalnumberofeventseen\"}[5m]))",
          "legendFormat": "events/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Kafka messages in",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": false }, "unit": "ops" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "expr": "sum by (topic) (rate(kafka_server_brokertopicmetrics_count{name=\"MessagesInPerSec\",topic=~\"dbserver1.public.*\"}[5m]))",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Flink records",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": false }, "unit": "ops" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "expr": "sum(flink_taskmanager_job_task_numRecordsInPerSecond)",
          "legendFormat": "in",
          "refId": "A"
        },
        {
          "expr": "sum(flink_taskmanager_job_task_numRecordsOutPerSecond)",
          "legendFormat": "out",
          "refId": "B"
        }
      ]
    },
    {
      "id": 11,
      "title": "Silo puts",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": false }, "unit": "ops" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "expr": "sum(rate(minio_s3_requests_total{api=~\"(?i)putobject\"}[5m]))",
          "legendFormat": "PutObject",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Debezium lag",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": false }, "unit": "ms" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "expr": "max({__name__=~\"debezium_.*millisecondsbehindsource\"})",
          "legendFormat": "MilliSecondsBehindSource",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Slot lag",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": false }, "unit": "bytes" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "expr": "pg_debezium_slot_lag_bytes",
          "legendFormat": "{{slot_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "title": "Consumer lag",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": false }, "unit": "short" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "expr": "sum by (topic) (kafka_consumergroup_lag{consumergroup=\"flink-stream-join\"})",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "title": "Checkpoint duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": false }, "unit": "ms" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "expr": "flink_jobmanager_job_lastCheckpointDuration",
          "legendFormat": "last checkpoint",
          "refId": "A"
        },
        {
          "expr": "vector(10000)",
          "legendFormat": "10s",
          "refId": "B"
        }
      ]
    },
    {
      "id": 16,
      "title": "Join complete vs incomplete",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": false }, "unit": "short" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "expr": "sum(flink_taskmanager_job_task_operator_join_complete)",
          "legendFormat": "complete",
          "refId": "A"
        },
        {
          "expr": "sum(flink_taskmanager_job_task_operator_join_incomplete)",
          "legendFormat": "incomplete",
          "refId": "B"
        }
      ]
    },
    {
      "id": 17,
      "title": "Lookup miss rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": false },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "expr": "sum(flink_taskmanager_job_task_operator_join_player_lookup_misses) / clamp_min(sum(flink_taskmanager_job_task_operator_join_player_lookup_hits) + sum(flink_taskmanager_job_task_operator_join_player_lookup_misses), 1)",
          "legendFormat": "miss rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 18,
      "title": "Rank defaulted rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": false },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "expr": "sum(flink_taskmanager_job_task_operator_join_rank_as_of_defaulted) / clamp_min(sum(flink_taskmanager_job_task_operator_join_rank_as_of_found) + sum(flink_taskmanager_job_task_operator_join_rank_as_of_defaulted), 1)",
          "legendFormat": "defaulted rate",
          "refId": "A"
        }
      ]
    }
  ],
