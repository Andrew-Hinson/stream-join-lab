{
  "annotations": { "list": [] },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Checkpoint duration",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "ms", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 8000 }, { "color": "red", "value": 10000 }] } },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        { "expr": "flink_jobmanager_job_lastCheckpointDuration", "legendFormat": "duration", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "Failed checkpoints",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        { "expr": "flink_jobmanager_job_numberOfFailedCheckpoints", "legendFormat": "failed", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "Checkpoint size",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value"
      },
      "targets": [
        { "expr": "flink_jobmanager_job_lastCheckpointSize", "legendFormat": "size", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "Checkpoint duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": false }, "unit": "ms" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        { "expr": "flink_jobmanager_job_lastCheckpointDuration", "legendFormat": "last checkpoint", "refId": "A" },
        { "expr": "vector(10000)", "legendFormat": "10s", "refId": "B" }
      ]
    },
    {
      "id": 5,
      "title": "Failed checkpoints",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": false }, "unit": "short" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        { "expr": "flink_jobmanager_job_numberOfFailedCheckpoints", "legendFormat": "failed", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "title": "Checkpoint size",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": false }, "unit": "bytes" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        { "expr": "flink_jobmanager_job_lastCheckpointSize", "legendFormat": "size", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "title": "Busy time by operator",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": false }, "unit": "ms" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "expr": "sum by (task_name) (flink_taskmanager_job_task_busyTimeMsPerSecond{task_name=~\".*(PlayerLookup|MatchJoin|RankAsOf|match_events|match_participants|players|ranks|Iceberg).*\"})",
          "legendFormat": "{{task_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Backpressure by operator",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": false }, "unit": "ms" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "expr": "sum by (task_name) (flink_taskmanager_job_task_backPressuredTimeMsPerSecond{task_name=~\".*(PlayerLookup|MatchJoin|RankAsOf|match_events|match_participants|players|ranks|Iceberg).*\"})",
          "legendFormat": "{{task_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "JVM heap",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": false }, "unit": "bytes" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        { "expr": "flink_jobmanager_Status_JVM_Memory_Heap_Used", "legendFormat": "JM used", "refId": "A" },
        { "expr": "flink_jobmanager_Status_JVM_Memory_Heap_Max", "legendFormat": "JM max", "refId": "B" },
        { "expr": "flink_taskmanager_Status_JVM_Memory_Heap_Used", "legendFormat": "TM used {{instance}}", "refId": "C" },
        { "expr": "flink_taskmanager_Status_JVM_Memory_Heap_Max", "legendFormat": "TM max {{instance}}", "refId": "D" }
      ]
    },
    {
      "id": 10,
      "title": "GC time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": false }, "unit": "s" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        { "expr": "rate(flink_jobmanager_Status_JVM_GarbageCollector_G1_Young_Generation_Time[5m])", "legendFormat": "JM young", "refId": "A" },
        { "expr": "rate(flink_jobmanager_Status_JVM_GarbageCollector_G1_Old_Generation_Time[5m])", "legendFormat": "JM old", "refId": "B" },
        { "expr": "rate(flink_taskmanager_Status_JVM_GarbageCollector_G1_Young_Generation_Time[5m])", "legendFormat": "TM young {{instance}}", "refId": "C" },
        { "expr": "rate(flink_taskmanager_Status_JVM_GarbageCollector_G1_Old_Generation_Time[5m])", "legendFormat": "TM old {{instance}}", "refId": "D" }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["flink"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 2,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-5m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Flink",
  "uid": "flink",
  "version": 1,
  "weekStart": ""
}
