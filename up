#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"
LAB_ENV="$ROOT/.lab.env"
WAIT_SECS=600
PORT_CAP=100

compose() {
  if [[ -f "$LAB_ENV" ]]; then
    docker compose --env-file "$LAB_ENV" "$@"
  else
    docker compose "$@"
  fi
}

banner() {
  echo
  echo "Clean start: existing Lab volumes will be destroyed."
  echo "First run is about 20 minutes (image pulls + Maven). Later runs are faster."
  echo "Match facts and Grafana open when Ready (at least one match_facts row), or after 10 minutes."
  echo
}

wait_docker() {
  local i
  for i in $(seq 1 30); do
    if docker info >/dev/null 2>&1; then
      return 0
    fi
    echo "Waiting for Docker Desktop... ($i/30)"
    sleep 2
  done
  echo "Docker is not running. Open Docker Desktop and re-run ./up." >&2
  exit 1
}

require_compose_v2() {
  if ! docker compose version >/dev/null 2>&1; then
    echo "Need Docker Compose v2 (docker compose). Install Docker Desktop or the Compose plugin." >&2
    exit 1
  fi
}

docker_is_desktop() {
  docker info --format '{{.OperatingSystem}}' 2>/dev/null | grep -q Desktop
}

ram_hint() {
  if docker_is_desktop; then
    echo "Docker Desktop → Settings → Resources → Memory."
  else
    echo "Give this Docker daemon more RAM, or close other containers."
  fi
}

check_ram() {
  local bytes gib
  bytes="$(docker info --format '{{.MemTotal}}')"
  gib="$(awk -v b="$bytes" 'BEGIN { printf "%.1f", b/1024/1024/1024 }')"
  local fail=$((6 << 30))
  local warn=$((8 << 30))
  if (( bytes < fail )); then
    echo "Docker has ${gib} GiB. Need at least 6 GiB (8 GiB is comfortable)." >&2
    ram_hint >&2
    exit 1
  fi
  if (( bytes < warn )); then
    echo "Docker has ${gib} GiB — tight. Raise the slider to 8 GiB+."
    ram_hint
  fi
}

port_free() {
  local port="$1"
  if command -v python3 >/dev/null 2>&1; then
    python3 -c '
import socket, sys
s = socket.socket()
s.settimeout(0.25)
try:
    s.connect(("127.0.0.1", int(sys.argv[1])))
except OSError:
    raise SystemExit(0)
s.close()
raise SystemExit(1)
' "$port"
    return $?
  fi
  if (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then
    exec 3<&- 3>&-
    return 1
  fi
  return 0
}

pick_port() {
  local name="$1"
  local start="$2"
  local p="$start"
  local max=$((start + PORT_CAP))
  while (( p <= max )); do
    if port_free "$p"; then
      echo "$p"
      return 0
    fi
    p=$((p + 1))
  done
  echo "No free port for $name in ${start}-${max}. Something is using ${start}." >&2
  exit 1
}

write_lab_env() {
  local superset grafana flink
  superset="$(pick_port SUPERSET 8088)"
  grafana="$(pick_port GRAFANA 3000)"
  flink="$(pick_port FLINK 8081)"
  cat > "$LAB_ENV" <<EOF
SUPERSET_PORT=$superset
GRAFANA_PORT=$grafana
FLINK_PORT=$flink
EOF
}

http_ok() {
  local url="$1"
  command -v curl >/dev/null 2>&1 || return 0
  curl -sf -o /dev/null --max-time 2 "$url" 2>/dev/null
}

fact_count() {
  local out
  out="$(compose exec -T trino trino --output-format CSV_UNQUOTED --execute \
    'SELECT COUNT(*) FROM iceberg.demo.match_facts' 2>/dev/null || true)"
  out="${out//[$'\t\r\n ']/}"
  if [[ "$out" =~ ^[0-9]+$ ]]; then
    echo "$out"
  else
    echo 0
  fi
}

wait_ready() {
  # shellcheck disable=SC1090
  source "$LAB_ENV"
  local deadline=$((SECONDS + WAIT_SECS))
  local n=0
  echo "Waiting until match_facts has a row (Ready), up to 10 minutes..."
  while (( SECONDS < deadline )); do
    n="$(fact_count)"
    if (( n >= 1 )) && http_ok "http://127.0.0.1:${SUPERSET_PORT}/health" \
      && http_ok "http://127.0.0.1:${GRAFANA_PORT}/api/health"; then
      echo "Ready: $n match_facts row(s)."
      return 0
    fi
    sleep 5
  done
  n="$(fact_count)"
  if (( n < 1 )); then
    echo "Still filling: no match_facts rows after 10 minutes. Opening UIs anyway."
  else
    echo "Ready: $n match_facts row(s). UIs may still be starting."
  fi
}

print_urls() {
  # shellcheck disable=SC1090
  source "$LAB_ENV"
  echo
  echo "========================================"
  echo " Match facts  http://127.0.0.1:${SUPERSET_PORT}/superset/dashboard/match-facts/"
  echo " Grafana      http://127.0.0.1:${GRAFANA_PORT}/d/pipeline-health"
  echo " Flink        http://127.0.0.1:${FLINK_PORT}"
  echo "========================================"
  echo
}

open_url() {
  local url="$1"
  if command -v open >/dev/null 2>&1; then
    open "$url" >/dev/null 2>&1 || true
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1 || true
  fi
}

banner
wait_docker
require_compose_v2
check_ram

echo "Wiping Lab volumes..."
compose down -v >/dev/null 2>&1 || true

write_lab_env
# shellcheck disable=SC1090
source "$LAB_ENV"
echo "Starting Lab (Superset ${SUPERSET_PORT}, Grafana ${GRAFANA_PORT}, Flink ${FLINK_PORT})..."
compose up --build -d

wait_ready
print_urls
open_url "http://127.0.0.1:${SUPERSET_PORT}/superset/dashboard/match-facts/"
open_url "http://127.0.0.1:${GRAFANA_PORT}/d/pipeline-health"
